# Keep image small and reproducible by excluding artifacts that are
# either generated at runtime or unused by the simulation runtime.

# Generated outputs (regenerated by the simulation itself).
output/
.archive/

# Local virtual environments and caches.
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE / editor.
.vscode/
.idea/
.DS_Store

# Documentation and notebooks (not needed at runtime; consult on GitHub).
docs/
colab/
*.md
!README.md

# Git metadata.
.git/
.github/
.gitignore

# Containerfile self-reference.
Dockerfile
.dockerignore
